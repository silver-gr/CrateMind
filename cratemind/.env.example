# CrateMind config — copy to backend/.env
# Comma-separated absolute paths to music library roots
CRATEMIND_LIBRARY_ROOTS=/path/to/music
# Where exports are written (never overwrites source libraries)
CRATEMIND_OUTPUT_DIR=./data/exports
# SQLite DB location
CRATEMIND_DB_PATH=./data/cratemind.sqlite
# Backups dir (DB snapshot taken on launch)
CRATEMIND_BACKUP_DIR=./data/backups
# Keep last N backups
CRATEMIND_BACKUP_KEEP=10
# External tool paths (auto-detected on PATH if blank)
CRATEMIND_FFPROBE_PATH=
CRATEMIND_FPCALC_PATH=
# Frontend dev origin for CORS
CRATEMIND_CORS_ORIGINS=http://localhost:5173
