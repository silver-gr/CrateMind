# CrateMind config — copy to backend/.env
# Comma-separated absolute paths to music library roots
CRATEMIND_LIBRARY_ROOTS=/path/to/music
# Where exports are written (never overwrites source libraries)
CRATEMIND_OUTPUT_DIR=./data/exports
# SQLite DB location
CRATEMIND_DB_PATH=./data/cratemind.sqlite
# Backups dir (DB snapshot taken on launch)
CRATEMIND_BACKUP_DIR=./data/backups
# Keep last N backups
CRATEMIND_BACKUP_KEEP=10
# External tool paths (auto-detected on PATH if blank)
CRATEMIND_FFPROBE_PATH=
CRATEMIND_FPCALC_PATH=
CRATEMIND_FFMPEG_PATH=
# BPM validation: Essentia runs locally for every unanalyzed track.
# ReccoBeats receives only a 30-second MP3 from local-engine disagreements.
CRATEMIND_BPM_DISAGREEMENT_PERCENT=3.0
CRATEMIND_RECCOBEATS_ENABLED=true
CRATEMIND_RECCOBEATS_API_URL=https://api.reccobeats.com/v1/analysis/audio-features
CRATEMIND_RECCOBEATS_TIMEOUT_SECONDS=60
CRATEMIND_RECCOBEATS_CLIP_START_SECONDS=60
# Optional catalog vote. GetSongBPM registration/API key required.
CRATEMIND_GETSONGBPM_ENABLED=false
CRATEMIND_GETSONGBPM_API_URL=https://api.getsong.co
CRATEMIND_GETSONGBPM_API_KEY=
CRATEMIND_GETSONGBPM_TIMEOUT_SECONDS=30
# Final fallback. Hard lifetime cap prevents spending more than account's five credits.
CRATEMIND_CYANITE_ENABLED=false
CRATEMIND_CYANITE_API_URL=https://api.cyanite.ai/graphql
CRATEMIND_CYANITE_ACCESS_TOKEN=
CRATEMIND_CYANITE_TIMEOUT_SECONDS=60
CRATEMIND_CYANITE_ANALYSIS_CREDIT_LIMIT=5
# Frontend dev origin for CORS
CRATEMIND_CORS_ORIGINS=http://localhost:5173
